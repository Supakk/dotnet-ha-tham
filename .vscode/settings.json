{
  // ── ฐานข้อมูลของโปรเจคนี้ ────────────────────────────────────────────────────
  //
  // โปรไฟล์ของส่วนขยาย SQL Server (ms-mssql.mssql) **ต้องอยู่ใน user settings**
  // ไม่ใช่ไฟล์นี้ — และห้ามประกาศ "mssql.connections" ไว้ตรงนี้เลยแม้แต่
  // อาร์เรย์ว่าง เพราะ setting ตัวนี้เป็น scope: resource ค่าใน workspace จะ
  // **ทับ** ค่าใน user settings ทั้งก้อน ผลคือพอเปิดโฟลเดอร์นี้ ส่วนขยายจะเห็น
  // รายการ connection ว่างเปล่าและโปรไฟล์หายไปทั้งที่ตั้งไว้ถูกแล้ว
  //
  // ตั้งโปรไฟล์ที่: Ctrl+Shift+P → "Preferences: Open User Settings (JSON)"
  //
  //   "mssql.connections": [
  //     {
  //       "profileName": "MamMoD dev (MMDEV)",
  //       "server": "(localdb)\\MSSQLLocalDB",
  //       "database": "MMDEV",
  //       "authenticationType": "Integrated",
  //       "trustServerCertificate": true,
  //       "connectTimeout": 30,
  //       "groupId": "ROOT"
  //     }
  //   ]
  //
  // ไม่มี username/password เพราะใช้ Windows Authentication
  //
  // ทำไมเป็น LocalDB ไม่ใช่ .\SQLEXPRESS
  // ---------------------------------------------------------------------------
  // ส่วนขยายคุยกับฐานผ่าน SqlToolsService ซึ่งใช้ managed SNI ที่รองรับแค่ TCP
  // กับ Named Pipes ส่วน SQLEXPRESS ในเครื่องนี้เปิดไว้แต่ Shared Memory
  // → ต่อแล้วได้ "TCP Provider ... The wait operation timed out"
  // LocalDB คุยผ่าน Named Pipes อยู่แล้ว จึงต่อได้โดยไม่ต้องใช้สิทธิ์ admin
  // ถ้าจะใช้ SQLEXPRESS ต้องเปิด TCP/IP ใน SQL Server Configuration Manager
  // (ต้องเป็น admin แล้วรีสตาร์ท service) แล้วเปลี่ยน server เป็น .\SQLEXPRESS
  //
  // รายละเอียดทั้งหมด: docs/data-model/README.md หัวข้อ 7

  // ให้ไฟล์ .sql ในโปรเจคเปิดมาพร้อมโหมด SQL ของส่วนขยาย
  "[sql]": {
    "editor.defaultFormatter": "ms-mssql.mssql",
    "editor.tabSize": 4
  },
  "files.associations": {
    "*.mmd": "markdown"
  }
}
