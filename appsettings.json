{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ไม่มี "Key" ตรงนี้ และห้ามใส่กลับเข้ามา — ไฟล์นี้ถูก commit ขึ้น repo สาธารณะ
  // กุญแจเซ็น JWT มาจาก environment variable ชื่อ Jwt__Key หรือถ้าเป็นตอน dev
  // จะถูกสร้างอัตโนมัติไว้ที่ .secrets/jwt-key ดูเหตุผลเต็ม ๆ ใน Services/JwtKey.cs
  "Jwt": {
    "Issuer": "mammod-tms",
    "Audience": "mammod-tms-client"
  },

  // origin ของ frontend ที่อนุญาตให้เรียกข้ามพอร์ตมาได้ ระบุเป็นรายตัวเพราะเปิด
  // AllowCredentials ไว้ให้ refresh cookie วิ่ง — spec ห้ามใช้ * คู่กับ credentials
  "Cors": {
    "Origins": [ "http://localhost:5700", "http://127.0.0.1:5700" ]
  },

  // ตอน Development ปล่อยให้ยิง API ได้โดยไม่ต้องมี token เพื่อให้ทดสอบผ่าน Swagger
  // และไฟล์ .http ได้สะดวก · นอกจาก Development จะบังคับต้องมี token ทุก endpoint
  // ตั้งเป็น true เพื่อบังคับตอน dev ด้วย
  "Auth": {
    "RequireAuthentication": false
  }
}
