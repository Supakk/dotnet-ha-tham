        decimal DELIVEREDQTY
        decimal SHORTQTY
        decimal DAMAGEQTY
        decimal GROSSWGT "ใช้ตรวจยอดรวมบน HDR"
        decimal CUBE
        nvarchar REASONCODE
        nvarchar STATUS
    }

    DOC_SHIPMENT_STATUS_LOG {
        int SERIALKEY PK "NEW — timeline 5 ขั้นต้องสอบย้อนได้"
        nvarchar WHSEID FK
        nvarchar SHIPMENTKEY FK
        nvarchar FROMSTATUS
        nvarchar TOSTATUS
        nvarchar SOURCESYSTEM "TMS | OMS | MMX | WMS | SAP"
        nvarchar MESSAGE
        datetime CHANGEDATE
        nvarchar CHANGEWHO
    }

    MST_CUSTOMER {
        nvarchar CUSTOMERKEY PK "NEW — ตัวที่ FK ชี้ได้จริง"
        nvarchar SHIPTO "เลขเดิมใน MST_SHIPTO เพื่อสอบย้อน"
        nvarchar CUSTOMERNAME
        nvarchar SUBDISTRICT "ที่อยู่แบบไทย ต่างจาก MST_SHIPTO"
        nvarchar DISTRICT
        nvarchar PROVINCE
        nvarchar POSTALCODE
        decimal LATITUDE "decimal ไม่ใช่ข้อความอย่าง gps1"
        decimal LONGITUDE
        nvarchar ZONE FK
        nvarchar ROUTE FK
        time TIMEWINDOW_FROM
        time TIMEWINDOW_TO
        bit COD_FLAG
        nvarchar STATUS
    }

    MST_SHIPTO {
        int SERIALKEY PK "PK เป็น SERIALKEY เดี่ยว — SHIPTO ไม่ unique"
        nvarchar SHIPTO "FK ชี้มาไม่ได้"
        nvarchar name "user-defined type"
        nvarchar city "ที่อยู่แบบตะวันตก แมปโซนไทยไม่ได้"
        nvarchar state
        nvarchar zip
        nvarchar county
        nvarchar gps1 "พิกัดเป็นข้อความ nvarchar(200)"
    }

    DOC_DO_HDR {
        int SERIALKEY PK
        nvarchar ORDERKEY "ควรเป็น PK ร่วมกับ WHSEID"
        nvarchar EXTERNORDERKEY
        nvarchar SHIPTO "ชี้ MST_SHIPTO"
        nvarchar ROUTE FK "(+)"
        nvarchar ZONE FK "(+) เดิมมีแต่ ROUTE"
        int STOP
        nvarchar SHIPMENTID
        datetime DELIVERYDATE
        datetime REQUESTEDSHIPDATE
        datetime ACTUALSHIPDATE
        decimal TOTALQTY
        decimal TOTALGROSSWGT
        decimal TOTALCUBE
        nvarchar POKEY
        nvarchar STATUS
        rowversion ROWVER "(+)"
    }
