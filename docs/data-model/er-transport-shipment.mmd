        nvarchar TOPROVINCE
        nvarchar RATETYPE
        decimal MINWEIGHT
        decimal MAXWEIGHT
        decimal BASE_RATE
        decimal RATE_PER_KM
        decimal RATE_PER_KG
        decimal RATE_PER_CUBE
        decimal RATE_PER_PALLET
        decimal FUEL_SURCHARGE
        decimal MINIMUM_CHARGE
        nvarchar CURRENCY
        date EFFECTIVE_DATE
        date EXPIRE_DATE
        nvarchar STATUS
    }

    MST_TRANSPORTER_DOCUMENT {
        nvarchar DOCUMENTKEY PK
        nvarchar TRANSPORTERKEY FK
        nvarchar VEHICLEKEY FK "(+) ประกัน/ภาษีเป็นของคันรถ"
        nvarchar DOCUMENTTYPE
        date ISSUEDATE
        date EXPIREDATE
        nvarchar FILEPATH
        nvarchar FILEURL
        nvarchar STATUS
    }

    DOC_TRANSPORT_PLAN {
        nvarchar WHSEID PK "NEW — ชั้นแผน PL-… ที่หายไปทั้งชั้น"
        nvarchar PLANKEY PK
        datetime PLANDATE
        date DELIVERYDATE
        nvarchar ZONE FK
        nvarchar ROUTE FK
        nvarchar SHIPMENTKEY "ใบที่ออกจากแผนนี้"
        nvarchar STATUS "DRAFT | ISSUED | CANCELLED"
        nvarchar CANCELREASON
    }

    DOC_TRANSPORT_PLAN_LINE {
        nvarchar WHSEID PK "NEW"
        nvarchar PLANKEY PK
        nvarchar ORDERKEY PK "UNIQUE ทั่วตาราง — ของอยู่ได้แผนเดียว"
        nvarchar STATUS
    }

    DOC_SHIPMENT_HDR {
        nvarchar WHSEID PK
        nvarchar SHIPMENTKEY PK
        datetime SHIPMENTDATE "วันที่ออกเอกสาร"
        date DELIVERYDATE "(+) วันนัดส่ง — คนละวัน"
        nvarchar PLANKEY FK "(+)"
        nvarchar PARENT_SHIPMENTKEY FK "(+) ใบแม่ตอนแยกใบ"
        nvarchar ROUTE FK
        nvarchar ZONE FK
        nvarchar DOOR
        nvarchar TRANSPORTERKEY FK
        nvarchar VEHICLEKEY FK
        nvarchar DRIVERKEY FK
        nvarchar LICENSEPLATE "snapshot"
        nvarchar DRIVERNAME "snapshot"
        nvarchar TRAILERID
        nvarchar SEALNO "(+)"
        int ASSISTANTCOUNT "(+) เด็กติดรถ 0-3"
        datetime PLANNEDDEPARTURE
        datetime ACTUALDEPARTURE
        datetime PLANNEDARRIVAL
        datetime ACTUALARRIVAL
        int TOTALSTOP "คำนวณใหม่ทุกครั้งที่เขียน — มี view ตรวจให้"
        int TOTALORDER
        decimal TOTALWEIGHT
        decimal TOTALCUBE
        decimal MAXWEIGHT
        decimal MAXCUBE
        decimal UTILIZATION_WEIGHT "% ใช้ไป — ใช้เตือนเกินพิกัดได้เลย"
        decimal UTILIZATION_CUBE
        nvarchar RATEKEY FK
        decimal ESTIMATEDCOST
        decimal ACTUALCOST
        decimal TRIPPRICE "(+) แยกส่วนเพื่อตอบได้ว่าคิดจากอะไร"
        decimal PRICEADD "(+)"
        decimal PRICEDEDUCT "(+)"
        nvarchar FREIGHTNOTE "(+)"
        bit EXPRESS_FLAG "(+)"
        datetime CONFIRMDATE "(+)"
        datetime SENTDATE "(+)"
        nvarchar STATUSMESSAGE "(+) ข้อความที่ WMS/OMS ตีกลับ"
        nvarchar CANCELREASON "(+) ไม่บังคับกรอก"
        nvarchar STATUS "ฐานใช้ NEW/… ตัวใหญ่ · UI ใช้ draft/… ตัวเล็ก"
        rowversion ROWVER "(+) optimistic concurrency"
    }

    DOC_SHIPMENT_STOP {
        nvarchar WHSEID PK
        nvarchar SHIPMENTKEY PK
        int SHIPMENTSTOPID PK
        int STOPSEQ "ต้อง UNIQUE ต่อใบ (+)"
