        time TIMEWINDOW_TO
        int SERVICE_MINUTE
        nvarchar DELIVERY_STATUS
        nvarchar POD_STATUS
        nvarchar PODFILE
        nvarchar STATUS
    }

    DOC_SHIPMENT_DETAIL {
        nvarchar WHSEID PK
        nvarchar SHIPMENTKEY PK
        int SHIPMENTDETAILID PK
        int SHIPMENTSTOPID FK
        nvarchar ORDERKEY "UNIQUE ถ้าไม่ยกเลิก — ของอยู่ใบเดียว (+)"
        nvarchar EXTERNORDERKEY "เลข SO จาก SAP"
        nvarchar CUSTOMERKEY
        nvarchar ROUTE FK "(+)"
        nvarchar ZONE FK "(+)"
        datetime REQUIREDDELIVERYDATE
        decimal OUTWEIGHT
        decimal OUTCUBE
        decimal TOTALCOST
        nvarchar STATUS
    }

    DOC_SHIPMENT_DETAIL_LINE {
        nvarchar WHSEID PK
        nvarchar SHIPMENTKEY PK
        int SHIPMENTDETAILID PK
        int SHIPMENTLINENO PK
        nvarchar SKU
        nvarchar LOT
