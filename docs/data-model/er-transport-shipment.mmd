    MST_TRANSPORTER {
        nvarchar TRANSPORTERKEY PK "nvarchar(20)"
        nvarchar TRANSPORTERNAME
        nvarchar TRANSPORTERTYPE
        nvarchar TAXID
        nvarchar BRANCHCODE
        nvarchar SUBDISTRICT "ที่อยู่แบบไทยครบ"
        nvarchar DISTRICT
        nvarchar PROVINCE
        nvarchar POSTALCODE
        nvarchar SERVICEAREA "free text — ซ้อนกับ MST_ROUTE_ZONE"
        nvarchar PAYMENTTERM
        int CREDITTERM
        nvarchar BANKACCOUNT
        nvarchar STATUS "ACTIVE"
    }

    MST_VEHICLETYPE {
        nvarchar VEHICLETYPEKEY PK
        nvarchar VEHICLETYPENAME
        decimal MAXWEIGHT "ค่าเริ่มต้น — ค่าที่ผูกกับคันรถชนะ"
        decimal MAXCUBE
        decimal MAXPALLET "UI ยังไม่มีแนวคิดพาเลท"
        decimal MAXUNITS
        decimal LENGTH
        decimal WIDTH
        decimal HEIGHT
        nvarchar STATUS
    }

    MST_VEHICLE {
        nvarchar VEHICLEKEY PK
        nvarchar TRANSPORTERKEY FK
        nvarchar VEHICLETYPEKEY FK
        nvarchar LICENSEPLATE "ต้องเพิ่ม UNIQUE (+)"
        nvarchar LICENSEPROVINCE
        nvarchar PLATE_TRAILER "(+) รถพ่วงมีสองทะเบียน"
        nvarchar PLATE_TRAILER_PROVINCE "(+)"
        nvarchar CHASSISNO
        nvarchar ENGINENO
        decimal MAXWEIGHT
        decimal MAXCUBE
        decimal MAXPALLET
        nvarchar GPSDEVICEID
        date REGISTRATIONEXPIRE
        date INSURANCEEXPIRE
        date NEXTSERVICE_DATE
        nvarchar STATUS
    }

    MST_DRIVER {
        nvarchar DRIVERKEY PK
        nvarchar TRANSPORTERKEY FK
        nvarchar DRIVERNAME
        nvarchar IDCARDNO
        nvarchar MOBILE
        nvarchar LICENSE_NO
        nvarchar LICENSE_TYPE "มีอยู่แล้ว"
        date LICENSE_EXPIRE_DATE
        nvarchar DEFAULT_VEHICLEKEY FK
        nvarchar STATUS
    }

    MST_ROUTE {
        nvarchar ROUTE PK "NEW — เดิมเป็นข้อความลอยใน 6 ตาราง"
        nvarchar ROUTENAME
        nvarchar ORIGIN_WHSEID "DC ที่รถออก"
        nvarchar COLOURHEX "สีเส้นบนแผนที่"
        int TRANSIT_DAY
        time CUT_OFF_TIME
        nvarchar STATUS
    }

    MST_DELIVERY_ZONE {
        nvarchar ZONE PK "NEW — คนละเรื่องกับ MST_ZONE ที่เป็นโซนในคลัง"
        nvarchar ZONENAME
        decimal MAX_VEHICLE_WEIGHT "น้ำหนักรถสูงสุดที่เข้าพื้นที่ได้ — ต้องยืนยันความหมาย"
        int SERVICE_MINUTE
        nvarchar STATUS
    }

    MST_ZONE_COVERAGE {
        int SERIALKEY PK "NEW — 1 โซนต่อหลายพื้นที่"
        nvarchar ZONE FK
        nvarchar PROVINCE
        nvarchar DISTRICT
        nvarchar SUBDISTRICT
        nvarchar POSTALCODE "ตัวที่ใช้จัดโซนให้ใบสั่งส่งอัตโนมัติ"
    }

    MST_ROUTE_ZONE {
        nvarchar ROUTE PK "NEW"
        nvarchar ZONE PK
        int SEQUENCE "ลำดับการวิ่ง"
        bit DEFAULT_FLAG "สายหลักของโซนนี้ — UNIQUE ต่อโซน"
        nvarchar STATUS
    }

    MST_TRANSPORTER_ROUTE {
        nvarchar TRANSPORTERKEY PK
        nvarchar ROUTE PK "ผูก FK ได้แล้ว (+)"
        nvarchar ZONE "อยู่นอก PK — แตกรายโซนไม่ได้"
        int PRIORITY
        bit DEFAULT_FLAG
        int TRANSIT_DAY
        time CUT_OFF_TIME
        nvarchar STATUS
    }

    MST_TRANSPORT_RATE {
        nvarchar RATEKEY PK
        nvarchar TRANSPORTERKEY FK
        nvarchar VEHICLETYPEKEY FK
        nvarchar ROUTE FK "ผูก FK ได้แล้ว (+)"
        nvarchar ZONE FK "(+)"
