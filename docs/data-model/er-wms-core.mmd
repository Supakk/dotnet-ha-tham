    MST_WHSE {
        int SERIALKEY PK "PK เป็น SERIALKEY"
        nvarchar WHSEID "⚠ NULL ได้ และไม่ unique — ทุกตารางอ้างรหัสนี้ (+)"
        nvarchar description
        nvarchar time_zone
        uniqueidentifier RowPointer "UNIQUE"
    }

    MST_AREA {
        nvarchar WHSEID PK
        nvarchar AREACODE PK "ไดอะแกรมเรียก AREAKEY"
        nvarchar AREANAME
        nvarchar AREATYPE
        bit PUTAWAY_ALLOWED
        bit PICK_ALLOWED
        bit REPLENISH_ALLOWED
        nvarchar STATUS "ACTIVE"
    }

    MST_ZONE {
        nvarchar WHSEID PK
        nvarchar PUTAWAYZONE PK "ไดอะแกรมเรียก ZONECODE"
        nvarchar AREACODE FK
        nvarchar ZONENAME
        int PUTAWAYSEQ
        int PICKSEQ
        int REPLENISHSEQ
        decimal TEMPERATURE_MIN
        decimal TEMPERATURE_MAX
        nvarchar STATUS
    }

    MST_LOCATION {
        nvarchar WHSEID PK
        nvarchar LOC PK
        nvarchar AREACODE FK
        nvarchar ZONECODE FK "ชี้ MST_ZONE.PUTAWAYZONE"
        nvarchar LOCATIONTYPE
        nvarchar AISLE
        nvarchar BAY
